DATABASE_URL="postgresql://erp_app:changeme@localhost:5432/erp_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
PORT=3000
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-now"

# Comma-separated browser origins allowed to call this API (admin-web, future
# mobile web views, etc). Defaults to the admin-web dev server if unset.
CORS_ORIGINS="http://localhost:5173"

# Backup/restore-test only (backend/src/modules/backup, backend/tests/backup.test.ts).
# TEST_POSTGRES_SUPERUSER_URL is used ONLY to create/drop a throwaway restore-test
# database — never the app's own runtime credentials. Leave unset to skip these tests.
PG_BIN_DIR="C:\Program Files\PostgreSQL\17\bin"
BACKUP_ENCRYPTION_KEY_HEX="replace-with-64-hex-chars-32-bytes-for-aes-256"
TEST_POSTGRES_SUPERUSER_URL="postgresql://postgres:changeme@localhost:5432/postgres"

# Google Drive backup upload (backend/src/modules/backup/driveUploadService.ts,
# backend/tests/drive-backup.test.ts). A bare service account has NO storage
# quota on a personal (non-Workspace) Drive, so this authenticates as the
# owner's own Google account via OAuth instead. One-time setup:
#   1. Create an OAuth client (type: Desktop app) in Google Cloud Console and
#      put its ID/secret below.
#   2. Run `npx tsx scripts/driveOAuthSetup.ts` and approve access once in a
#      browser — it appends GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN to .env for you.
# Leave any of these unset to skip the Drive upload test.
GOOGLE_OAUTH_CLIENT_ID="replace-with-your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-your-oauth-client-secret"
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN="set-automatically-by-scripts/driveOAuthSetup.ts"
GOOGLE_DRIVE_BACKUP_FOLDER_ID="the-shared-drive-folder-id-from-its-url"
