DATABASE_URL="postgresql://erp_app:changeme@localhost:5432/erp_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
PORT=3000
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-now"

# Backup/restore-test only (backend/src/modules/backup, backend/tests/backup.test.ts).
# TEST_POSTGRES_SUPERUSER_URL is used ONLY to create/drop a throwaway restore-test
# database — never the app's own runtime credentials. Leave unset to skip these tests.
PG_BIN_DIR="C:\Program Files\PostgreSQL\17\bin"
BACKUP_ENCRYPTION_KEY_HEX="replace-with-64-hex-chars-32-bytes-for-aes-256"
TEST_POSTGRES_SUPERUSER_URL="postgresql://postgres:changeme@localhost:5432/postgres"
