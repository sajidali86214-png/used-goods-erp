// Data model implementing docs/02-data-model.md — STAGE 1 + STAGE 2.
// Stage 1: identity/access, master data, suppliers, purchasing,
// stock/movements, media, import-job tables.
// Stage 2: sales orders, grade requirements, reservations, picking,
// shipments, returns, refunds, cancellations, and a finance ledger.
// Stage 3 (ScreenshotExtractionJob, ...) is specified in docs/02-data-model.md
// section 8 and not yet created.
//
// Convention carried over from Stage 1: currencyId/paymentMethodAccountId-style
// reference-data fields on money-bearing rows are plain string columns, not
// enforced Prisma relations — validated by lookup in the service layer, not a
// DB foreign key. Structural/operational entities (orders, lines, grades,
// bins, cost layers, customers, accounts) use real relations throughout.
//
// MULTI-BRANCH: this business operates multiple physical branches, each
// running as an almost fully independent unit (own catalog, suppliers,
// customers, stock, orders, cash accounts, grading/channel/approval/FX
// config) — only RBAC policy (Role/Permission/RolePermission), Currency,
// ExpenseCategory/ReasonCode vocabulary, AppSetting, IdempotencyKey, and
// Investor/InvestorTransaction (company-wide capital, not per-location) are
// shared across branches. Every other model below carries a `branchId` and
// is enforced by a Prisma Client Extension (backend/src/lib/branchScopeExtension.ts),
// not by hand-written `where` clauses at each call site. See the "Multi-Branch
// Data Isolation" plan for the full design/rationale.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux); rhel-openssl-3.0.x is
  // Vercel's serverless function runtime -- without it the deployed
  // function can't find a matching query engine binary.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Branch (multi-branch foundation) ----------

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users                 User[]
  approvalThresholds    ApprovalThreshold[]
  auditEvents           AuditEvent[]
  approvals             Approval[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  productPhotos         ProductPhoto[]
  grades                Grade[]
  bins                  Bin[]
  salesChannels         SalesChannel[]
  paymentMethodAccounts PaymentMethodAccount[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderLines    PurchaseOrderLine[]
  supplierAdvances      SupplierAdvance[]
  supplierInvoices      SupplierInvoice[]
  supplierInvoiceLines  SupplierInvoiceLine[]
  supplierPayments      SupplierPayment[]
  supplierCredits       SupplierCredit[]
  grns                  GRN[]
  grnLines              GRNLine[]
  lots                  Lot[]
  landedCostAllocations LandedCostAllocation[]
  costLayers            CostLayer[]
  stockMovements        StockMovement[]
  stockStates           StockState[]
  individualItems       IndividualItem[]
  stockCounts           StockCount[]
  stockCountLines       StockCountLine[]
  mediaAssets           MediaAsset[]
  importJobs            ImportJob[]
  exchangeRateSnapshots ExchangeRateSnapshot[]
  customers             Customer[]
  salesOrders           SalesOrder[]
  salesOrderLines       SalesOrderLine[]
  bundleAllocations     BundleAllocation[]
  reservations          Reservation[]
  pickAllocations       PickAllocation[]
  shipments             Shipment[]
  shipmentLines         ShipmentLine[]
  returnRequests        ReturnRequest[]
  returnLines           ReturnLine[]
  refunds               Refund[]
  paymentReceipts       PaymentReceipt[]
  paymentAllocations    PaymentAllocation[]
  currencyConversions   CurrencyConversion[]
  cancellations         Cancellation[]
  accounts              Account[]
  ledgerEntries         LedgerEntry[]
  expenses              Expense[]
  transfers             Transfer[]
  ownerTransactions     OwnerTransaction[]
  periodLocks           PeriodLock[]
}

// ---------- Identity & access (Stage 1) ----------

model User {
  id           String    @id @default(uuid())
  branchId     String @default("00000000-0000-0000-0000-000000000001")
  name         String
  email        String    @unique
  passwordHash String
  mfaSecret    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch         Branch       @relation(fields: [branchId], references: [id])
  roles          UserRole[]
  auditEvents    AuditEvent[] @relation("AuditActor")
  approvalsGiven Approval[]   @relation("ApprovalDecider")
  approvalsAsked Approval[]   @relation("ApprovalRequester")
  investor       Investor?

  @@index([branchId])
}

// Restricted investor portal access: links a login to an agreed profit share.
// GLOBAL (not branch-scoped) — an investor funds the business as a whole,
// not one specific branch.
model Investor {
  id                 String   @id @default(uuid())
  name               String
  profitSharePercent Decimal  @db.Decimal(6, 3)
  // Which figure the % applies to — explicit and shown on the dashboard,
  // never silently assumed. "gross_profit" = net sales - COGS; operating_result
  // additionally deducts posted operating expenses.
  profitShareBasis   String   @default("operating_result") // gross_profit | operating_result
  userId             String?  @unique
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  user         User?                 @relation(fields: [userId], references: [id])
  transactions InvestorTransaction[]
}

// Investor capital movements — never cash-available-for-distribution by
// itself; the dashboard always shows this alongside (not instead of) the
// calculated profit share, so nothing here ever stands in for an estimate.
// GLOBAL, same reasoning as Investor above.
model InvestorTransaction {
  id         String   @id @default(uuid())
  investorId String
  type       String // contribution | withdrawal | distribution
  amount     Decimal  @db.Decimal(18, 4)
  occurredAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
}

// Small singleton key/value store for app-wide config (e.g. the letterhead image) — not a per-user preference. GLOBAL.
model AppSetting {
  key   String @id
  value String
}

// GLOBAL — RBAC policy is a business-wide decision, not a per-branch one.
model Role {
  id       String  @id @default(uuid())
  code     String  @unique // owner | manager | receiving | picker | seller | finance | viewer
  label    String
  isSystem Boolean @default(true)

  users       UserRole[]
  permissions RolePermission[]
  thresholds  ApprovalThreshold[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// GLOBAL.
model Permission {
  id    String @id @default(uuid())
  code  String @unique // e.g. cost.view, profit.view, refund.approve
  label String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model ApprovalThreshold {
  id             String  @id @default(uuid())
  branchId       String @default("00000000-0000-0000-0000-000000000001")
  scope          String // e.g. "refund_pkr", "discount_pct"
  roleId         String
  maxValue       Decimal @db.Decimal(18, 4)
  requiresSecond Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([branchId])
}

model AuditEvent {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  actorUserId      String
  action           String
  entityType       String
  entityId         String
  beforeJson       Json?
  afterJson        Json?
  reason           String?
  requestId        String?
  approvedByUserId String?
  createdAt        DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  actor  User   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([branchId, entityType, entityId])
}

model Approval {
  id             String    @id @default(uuid())
  branchId       String @default("00000000-0000-0000-0000-000000000001")
  entityType     String
  entityId       String
  requestedById  String
  decidedById    String?
  decision       String? // approved | rejected | pending
  reason         String?
  isSelfApproval Boolean   @default(false)
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  branch      Branch @relation(fields: [branchId], references: [id])
  requestedBy User   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy   User?  @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([branchId])
}

// ---------- Master / reference data (Stage 1) ----------

model Category {
  id         String     @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  name       String
  parentId   String?
  archivedAt DateTime?

  branch   Branch     @relation(fields: [branchId], references: [id])
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Brand {
  id         String    @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  name       String
  archivedAt DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  products Product[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Product {
  id               String    @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  skuCode          String
  name             String
  categoryId       String
  brandId          String?
  description      String?
  unitOfMeasure    String    @default("piece")
  sizeGroup        String?
  material         String?
  defaultSellPrice Decimal?  @db.Decimal(18, 4)
  minPrice         Decimal?  @db.Decimal(18, 4)
  isActive         Boolean   @default(true)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch          Branch              @relation(fields: [branchId], references: [id])
  category        Category            @relation(fields: [categoryId], references: [id])
  brand           Brand?              @relation(fields: [brandId], references: [id])
  photos          ProductPhoto[]
  grnLines        GRNLine[]
  lots            Lot[]
  movements       StockMovement[]
  stockStates     StockState[]
  individualItems IndividualItem[]
  poLines         PurchaseOrderLine[]
  salesOrderLines SalesOrderLine[]

  @@unique([branchId, skuCode])
  @@index([branchId])
}

model ProductPhoto {
  id               String  @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  productId        String
  mediaAssetId     String
  isRepresentative Boolean @default(true)
  caption          String?

  branch  Branch     @relation(fields: [branchId], references: [id])
  product Product    @relation(fields: [productId], references: [id])
  media   MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@index([branchId])
}

model Grade {
  id         String    @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  code       String // A | B | C | UNGRADED | ...
  label      String
  definition String?
  archivedAt DateTime?

  branch               Branch              @relation(fields: [branchId], references: [id])
  costLayers           CostLayer[]
  movements            StockMovement[]
  stockStates          StockState[]
  individualItems      IndividualItem[]
  reservations         Reservation[]
  pickAllocations      PickAllocation[]
  returnLinesOrigin    ReturnLine[]        @relation("ReturnLineOriginGrade")
  returnLinesInspected ReturnLine[]        @relation("ReturnLineInspectedGrade")
  purchaseOrderLines   PurchaseOrderLine[]
  grnLines             GRNLine[]

  @@unique([branchId, code])
  @@index([branchId])
}

model Bin {
  id         String    @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  code       String
  label      String
  archivedAt DateTime?

  branch          Branch           @relation(fields: [branchId], references: [id])
  costLayers      CostLayer[]
  movements       StockMovement[]
  stockStates     StockState[]
  reservations    Reservation[]
  pickAllocations PickAllocation[]

  @@unique([branchId, code])
  @@index([branchId])
}

// GLOBAL — a currency code means the same thing everywhere.
model Currency {
  id            String  @id @default(uuid())
  code          String  @unique // PKR | GBP | USD | ...
  symbol        String
  decimalPlaces Int     @default(2)
  isActive      Boolean @default(true)
}

model SalesChannel {
  id                   String    @id @default(uuid())
  branchId             String @default("00000000-0000-0000-0000-000000000001")
  code                 String // fleek | local_market | friend | online | instagram
  label                String
  defaultCommissionPct Decimal?  @db.Decimal(6, 3)
  archivedAt           DateTime?

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, code])
  @@index([branchId])
}

model PaymentMethodAccount {
  id         String    @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  label      String
  currencyId String
  kind       String // cash | bank | mobile_wallet
  archivedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// GLOBAL — pure vocabulary; the rows that use it (Expense) are branch-scoped.
model ExpenseCategory {
  id         String    @id @default(uuid())
  label      String
  archivedAt DateTime?
}

// GLOBAL — pure vocabulary; the rows that use it (ReturnLine) are branch-scoped.
model ReasonCode {
  id         String    @id @default(uuid())
  kind       String // cancellation | return | adjustment
  label      String
  archivedAt DateTime?
}

// ---------- Suppliers & purchasing (Stage 1) ----------

model Supplier {
  id                String   @id @default(uuid())
  branchId          String @default("00000000-0000-0000-0000-000000000001")
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  categories        String[]
  defaultCurrencyId String
  paymentTerms      String?
  bankDetails       Json? // access restricted at the API layer via supplier.payment_details.view
  taxDetails        Json?
  qualityAgreement  String?
  returnPolicy      String?
  isActive          Boolean  @default(true)
  approvalStatus    String   @default("pending")
  createdAt         DateTime @default(now())

  branch         Branch            @relation(fields: [branchId], references: [id])
  purchaseOrders PurchaseOrder[]
  advances       SupplierAdvance[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  credits        SupplierCredit[]
  grns           GRN[]
  lots           Lot[]

  @@index([branchId])
}

model PurchaseOrder {
  id                  String    @id @default(uuid())
  branchId            String @default("00000000-0000-0000-0000-000000000001")
  poNumber            String
  supplierId          String
  status              String    @default("draft") // draft | approved | cancelled | closed
  currencyId          String
  expectedReceiptDate DateTime?
  terms               String?
  notes               String?
  createdAt           DateTime  @default(now())

  branch   Branch              @relation(fields: [branchId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  advances SupplierAdvance[]
  invoices SupplierInvoice[]
  credits  SupplierCredit[]

  @@unique([branchId, poNumber])
  @@index([branchId])
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  branchId        String @default("00000000-0000-0000-0000-000000000001")
  poId            String
  productId       String
  gradeId         String? // intended grade mix ordered (e.g. AB, C) — informational until received
  orderedQty      Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 4)
  discount        Decimal? @db.Decimal(18, 4)
  additionalCosts Decimal? @db.Decimal(18, 4)

  branch   Branch        @relation(fields: [branchId], references: [id])
  po       PurchaseOrder @relation(fields: [poId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
  grade    Grade?        @relation(fields: [gradeId], references: [id])
  grnLines GRNLine[]

  @@index([branchId])
}

model SupplierAdvance {
  id                     String   @id @default(uuid())
  branchId               String @default("00000000-0000-0000-0000-000000000001")
  supplierId             String
  poId                   String?
  currencyId             String
  amount                 Decimal  @db.Decimal(18, 4)
  paidAt                 DateTime
  paymentMethodAccountId String
  status                 String   @default("open") // open | partially_applied | applied
  reference              String?

  branch   Branch         @relation(fields: [branchId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  po       PurchaseOrder? @relation(fields: [poId], references: [id])

  @@index([branchId])
}

model SupplierInvoice {
  id             String   @id @default(uuid())
  branchId       String @default("00000000-0000-0000-0000-000000000001")
  supplierId     String
  poId           String?
  currencyId     String
  amount         Decimal  @db.Decimal(18, 4)
  invoiceDate    DateTime
  dueDate        DateTime?
  matchedAdvance Decimal  @default(0) @db.Decimal(18, 4)
  status         String   @default("open") // open | partially_matched | matched — advance-match progress only
  // Separate lifecycle dimension from `status` above: whether the invoice
  // itself has been approved (posting Dr GRNI / Cr Accounts Payable), not
  // whether it's been matched against a prepaid advance.
  approvalStatus   String    @default("pending_approval") // pending_approval | approved
  approvedByUserId String?
  approvedAt       DateTime?
  // Set at creation if the three-way match (this invoice vs the GRN lines vs
  // the PO lines they were received against) found a quantity/price mismatch.
  // Never blocks creation — spec section 4: "hold exceptions for approval".
  hasVariance Boolean @default(false)
  isDisputed  Boolean @default(false)

  branch   Branch                 @relation(fields: [branchId], references: [id])
  supplier Supplier               @relation(fields: [supplierId], references: [id])
  po       PurchaseOrder?         @relation(fields: [poId], references: [id])
  payments SupplierPayment[]
  lines    SupplierInvoiceLine[]

  @@index([branchId])
}

// Links an invoice line to the specific GRN line it bills for — this is what
// makes the match a real three-way match (PO vs GRN vs invoice), not just an
// invoice-total-vs-PO-total comparison.
model SupplierInvoiceLine {
  id            String   @id @default(uuid())
  branchId      String   @default("00000000-0000-0000-0000-000000000001")
  invoiceId     String
  grnLineId     String
  quantity      Decimal  @db.Decimal(18, 4)
  unitPrice     Decimal  @db.Decimal(18, 4)
  amount        Decimal  @db.Decimal(18, 4)
  varianceNotes String?

  branch  Branch          @relation(fields: [branchId], references: [id])
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])
  grnLine GRNLine         @relation(fields: [grnLineId], references: [id])

  @@index([branchId])
}

model SupplierPayment {
  id                     String   @id @default(uuid())
  branchId               String @default("00000000-0000-0000-0000-000000000001")
  supplierId             String
  invoiceId              String?
  amount                 Decimal  @db.Decimal(18, 4)
  currencyId             String
  paidAt                 DateTime
  paymentMethodAccountId String
  reference              String?

  branch   Branch           @relation(fields: [branchId], references: [id])
  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([branchId])
}

// Money or a credit a supplier gives back to us — overpayment, returned
// goods, a price adjustment. Posted as Dr the receiving account, Cr
// Supplier Advances (reverses part of what we're effectively owed back),
// so it shows up in the same unapplied-advance balance a real advance does.
model SupplierCredit {
  id                 String   @id @default(uuid())
  branchId           String @default("00000000-0000-0000-0000-000000000001")
  supplierId         String
  poId               String?
  currencyId         String
  amount             Decimal  @db.Decimal(18, 4)
  receivedAt         DateTime
  receivingAccountId String
  reason             String
  createdAt          DateTime @default(now())

  branch   Branch         @relation(fields: [branchId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  po       PurchaseOrder? @relation(fields: [poId], references: [id])

  @@index([branchId])
}

model GRN {
  id                String   @id @default(uuid())
  branchId          String @default("00000000-0000-0000-0000-000000000001")
  grnNumber         String
  supplierId        String
  receiptDate       DateTime
  deliveryReference String?
  receivingUserId   String
  notes             String?
  createdAt         DateTime @default(now())

  branch   Branch    @relation(fields: [branchId], references: [id])
  supplier Supplier  @relation(fields: [supplierId], references: [id])
  lines    GRNLine[]
  lots     Lot[]

  @@unique([branchId, grnNumber])
  @@index([branchId])
}

model GRNLine {
  id              String  @id @default(uuid())
  branchId        String @default("00000000-0000-0000-0000-000000000001")
  grnId           String
  poLineId        String?
  productId       String
  gradeId         String? // grade actually received into (e.g. AB, C) — defaults to Ungraded/Inspection when omitted
  receivedQty     Decimal @db.Decimal(18, 4)
  rejectedQty     Decimal @default(0) @db.Decimal(18, 4)
  inspectionNotes String?

  branch       Branch                @relation(fields: [branchId], references: [id])
  grn          GRN                   @relation(fields: [grnId], references: [id])
  poLine       PurchaseOrderLine?    @relation(fields: [poLineId], references: [id])
  product      Product               @relation(fields: [productId], references: [id])
  grade        Grade?                @relation(fields: [gradeId], references: [id])
  lots         Lot[]
  invoiceLines SupplierInvoiceLine[]

  @@index([branchId])
}

model Lot {
  id                 String   @id @default(uuid())
  branchId           String @default("00000000-0000-0000-0000-000000000001")
  lotCode            String
  grnId              String?
  grnLineId          String?
  supplierId         String?
  productId          String
  originalCurrencyId String
  sourceUnitPrice    Decimal  @db.Decimal(18, 4)
  exchangeRate       Decimal  @db.Decimal(18, 6) // PKR per 1 unit of originalCurrency, locked at receipt
  notes              String?
  createdAt          DateTime @default(now())

  branch      Branch                 @relation(fields: [branchId], references: [id])
  grn         GRN?                   @relation(fields: [grnId], references: [id])
  grnLine     GRNLine?               @relation(fields: [grnLineId], references: [id])
  supplier    Supplier?              @relation(fields: [supplierId], references: [id])
  product     Product                @relation(fields: [productId], references: [id])
  costLayers  CostLayer[]
  landedCosts LandedCostAllocation[]

  @@unique([branchId, lotCode])
  @@index([branchId])
}

model LandedCostAllocation {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  lotId            String
  costType         String // freight | handling | other
  amount           Decimal  @db.Decimal(18, 4)
  currencyId       String
  allocationMethod String   @default("by_piece")
  appliedAt        DateTime @default(now())
  approvedByUserId String

  branch Branch @relation(fields: [branchId], references: [id])
  lot    Lot    @relation(fields: [lotId], references: [id])

  @@index([branchId])
}

// CostLayer is the unit stock valuation and COGS draw from.
// Grading transfers split a cost layer's quantity into new grade-specific
// cost layers at the SAME unitCost (quantity + value conservation).
model CostLayer {
  id                String   @id @default(uuid())
  branchId          String @default("00000000-0000-0000-0000-000000000001")
  lotId             String
  gradeId           String
  binId             String
  quantityOriginal  Decimal  @db.Decimal(18, 4)
  quantityRemaining Decimal  @db.Decimal(18, 4)
  unitCost          Decimal  @db.Decimal(18, 4) // landed cost per piece, fixed at creation
  splitFromLayerId  String?
  createdAt         DateTime @default(now())

  branch          Branch           @relation(fields: [branchId], references: [id])
  lot             Lot              @relation(fields: [lotId], references: [id])
  grade           Grade            @relation(fields: [gradeId], references: [id])
  bin             Bin              @relation(fields: [binId], references: [id])
  splitFrom       CostLayer?       @relation("CostLayerSplit", fields: [splitFromLayerId], references: [id])
  splitInto       CostLayer[]      @relation("CostLayerSplit")
  movements       StockMovement[]
  stockStates     StockState[]
  individualItems IndividualItem[]
  reservations    Reservation[]
  pickAllocations PickAllocation[]
  returnLines     ReturnLine[]

  @@index([branchId, lotId, gradeId, binId])
}

// ---------- Stock & movements (Stage 1) ----------

model StockMovement {
  id                  String   @id @default(uuid())
  branchId            String @default("00000000-0000-0000-0000-000000000001")
  type                String // receive_to_inspection | grading_transfer | bin_transfer | reserve | release | pick | dispatch | return_receipt | return_to_bulk | write_off | count_adjustment | supplier_return_dispatch
  productId           String
  gradeId             String
  binId               String
  costLayerId         String
  quantity            Decimal  @db.Decimal(18, 4) // always positive; direction implied by `type`
  relatedDocumentType String?
  relatedDocumentId   String?
  actorUserId         String
  occurredAt          DateTime @default(now())

  branch    Branch    @relation(fields: [branchId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  grade     Grade     @relation(fields: [gradeId], references: [id])
  bin       Bin       @relation(fields: [binId], references: [id])
  costLayer CostLayer @relation(fields: [costLayerId], references: [id])

  @@index([branchId, productId, gradeId, binId, costLayerId])
}

// Materialized balance, reconciled against StockMovement. Never written to
// directly except by the movement-posting service inside the same transaction.
model StockState {
  id          String  @id @default(uuid())
  branchId    String @default("00000000-0000-0000-0000-000000000001")
  productId   String
  gradeId     String
  binId       String
  costLayerId String
  state       String // inspection | saleable | picking | packed | dispatched | return_inspection | repair | damaged | supplier_return_dispatched
  onHandQty   Decimal @default(0) @db.Decimal(18, 4)
  reservedQty Decimal @default(0) @db.Decimal(18, 4)
  version     Int     @default(0) // optimistic lock for concurrent reservation/dispatch

  branch    Branch    @relation(fields: [branchId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  grade     Grade     @relation(fields: [gradeId], references: [id])
  bin       Bin       @relation(fields: [binId], references: [id])
  costLayer CostLayer @relation(fields: [costLayerId], references: [id])

  // Not branchId-prefixed: every component (costLayerId especially) is already
  // scoped to one branch via its own FK chain, so two branches can never
  // collide on this key — adding branchId here would only break every
  // existing compound-key lookup across the stock/sales modules for no real
  // safety gain. branchId still gets its own plain index below, for the
  // enforcement extension's read-filtering.
  @@unique([productId, gradeId, binId, costLayerId, state])
  @@index([branchId])
}

model IndividualItem {
  id                    String   @id @default(uuid())
  branchId              String @default("00000000-0000-0000-0000-000000000001")
  productId             String
  sourceCostLayerId     String
  gradeId               String
  status                String   @default("listed") // listed | sold | returned_to_bulk
  createdFromMovementId String
  returnedToMovementId  String?
  createdAt             DateTime @default(now())

  branch          Branch       @relation(fields: [branchId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  sourceCostLayer CostLayer    @relation(fields: [sourceCostLayerId], references: [id])
  grade           Grade        @relation(fields: [gradeId], references: [id])
  photos          MediaAsset[]

  @@index([branchId])
}

model StockCount {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  countDate        DateTime
  binId            String?
  status           String   @default("draft") // draft | submitted | approved
  approvedByUserId String?
  createdAt        DateTime @default(now())

  branch Branch           @relation(fields: [branchId], references: [id])
  lines  StockCountLine[]

  @@index([branchId])
}

model StockCountLine {
  id           String  @id @default(uuid())
  branchId     String @default("00000000-0000-0000-0000-000000000001")
  stockCountId String
  productId    String
  gradeId      String
  costLayerId  String
  countedQty   Decimal @db.Decimal(18, 4)
  systemQty    Decimal @db.Decimal(18, 4)
  varianceQty  Decimal @db.Decimal(18, 4)

  branch     Branch     @relation(fields: [branchId], references: [id])
  stockCount StockCount @relation(fields: [stockCountId], references: [id])

  @@index([branchId])
}

// ---------- Media (Stage 1) ----------

model MediaAsset {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  kind             String // product | lot | order | individual_item | attachment
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String
  uploadStatus     String   @default("pending") // pending | complete | failed
  createdAt        DateTime @default(now())

  branch           Branch          @relation(fields: [branchId], references: [id])
  productPhotos    ProductPhoto[]
  individualItemId String?
  individualItem   IndividualItem? @relation(fields: [individualItemId], references: [id])

  @@index([branchId])
}

// ---------- Imports (Stage 1 tooling) ----------

model ImportJob {
  id            String   @id @default(uuid())
  branchId      String @default("00000000-0000-0000-0000-000000000001")
  kind          String // products | suppliers | opening_stock
  fileRef       String
  status        String   @default("pending") // pending | validated | committed | failed
  allOrNothing  Boolean  @default(true)
  resultSummary Json?
  errors        Json?
  createdAt     DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// ---------- Exchange rates (Stage 1, used from Stage 2) ----------

model ExchangeRateSnapshot {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  fromCurrencyId   String
  toCurrencyId     String // PKR by convention
  rate             Decimal  @db.Decimal(18, 6)
  source           String
  capturedAt       DateTime @default(now())
  isManualOverride Boolean  @default(false)
  overrideReason   String?
  overrideByUserId String?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// =====================================================================
// STAGE 2 — Sales, fulfilment, returns/refunds, finance
// =====================================================================

// ---------- Sales ----------

model Customer {
  id        String   @id @default(uuid())
  branchId  String @default("00000000-0000-0000-0000-000000000001")
  name      String
  contact   String? // phone or email
  address   String?
  city      String?
  country   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch          Branch           @relation(fields: [branchId], references: [id])
  orders          SalesOrder[]
  paymentReceipts PaymentReceipt[]

  @@index([branchId])
}

model SalesOrder {
  id                    String   @id @default(uuid())
  branchId              String @default("00000000-0000-0000-0000-000000000001")
  orderNumber           String
  channelId             String // SalesChannel.id, plain reference (see file header)
  externalOrderId       String?
  customerId            String
  currencyId            String
  status                String   @default("draft") // draft | confirmed | partially_cancelled | cancelled | closed
  paymentStatus         String   @default("unpaid") // unpaid | partially_paid | paid
  fulfilmentStatus      String   @default("unfulfilled") // unfulfilled | picking | packed | partially_dispatched | dispatched | partially_delivered | delivered | returned | cancelled
  qcStatus              String   @default("pending") // pending | approved | rejected — manual quality-check gate before an order ships
  returnStatus          String   @default("none") // none | requested | authorized | partially_received | received | inspected | resolved
  refundStatus          String   @default("none") // none | pending | partially_refunded | refunded
  salespersonUserId     String?
  notes                 String?
  shippingPerUnit       Decimal? @db.Decimal(18, 4) // per-piece shipping cost; total = shippingPerUnit * sum(line quantities)
  commissionType        String? // percentage | fixed
  commissionValue       Decimal? @db.Decimal(18, 4) // meaning depends on commissionType: a % or an absolute amount
  paymentReceivedAmount Decimal? @db.Decimal(18, 4) // manual entry from the quick "mark payment received" popup — no ledger/account impact
  returnedQuantity      Decimal? @db.Decimal(18, 4) // manual entry from the quick "mark returned" popup — pieces returned, not stock-movement-backed
  refundAmount          Decimal? @db.Decimal(18, 4) // manual entry from the quick "mark returned" popup
  cancellationAmount    Decimal? @db.Decimal(18, 4) // manual entry from the quick "mark cancelled" popup
  createdAt             DateTime @default(now())

  branch             Branch              @relation(fields: [branchId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id])
  lines              SalesOrderLine[]
  shipments          Shipment[]
  returnRequests     ReturnRequest[]
  refunds            Refund[]
  paymentAllocations PaymentAllocation[]

  @@unique([branchId, orderNumber])
  @@index([branchId, channelId, externalOrderId]) // duplicate-order detection (screenshot flow, Stage 3)
}

model SalesOrderLine {
  id                   String   @id @default(uuid())
  branchId             String @default("00000000-0000-0000-0000-000000000001")
  orderId              String
  productId            String
  gradeRequirementType String   @default("none") // none | allowed_set | exact_composition
  allowedGradeIds      String[] // used when gradeRequirementType = allowed_set
  exactGradeQuantities Json? // { [gradeId]: quantity } used when gradeRequirementType = exact_composition
  quantity             Decimal  @db.Decimal(18, 4)
  unitPrice            Decimal? @db.Decimal(18, 4)
  bundleGroupId        String? // lines sharing this id share one bundle total price
  bundleTotalPrice     Decimal? @db.Decimal(18, 4)
  discount             Decimal? @db.Decimal(18, 4) // legacy flat-amount discount; superseded by discountType/discountValue when set
  discountType         String? // percentage | fixed
  discountValue        Decimal? @db.Decimal(18, 4) // meaning depends on discountType: a % of (quantity * unitPrice), or an absolute amount
  taxesFees            Decimal? @db.Decimal(18, 4)
  createdAt            DateTime @default(now())

  branch           Branch            @relation(fields: [branchId], references: [id])
  order            SalesOrder        @relation(fields: [orderId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  bundleAllocation BundleAllocation?
  reservations     Reservation[]
  pickAllocations  PickAllocation[]
  shipmentLines    ShipmentLine[]
  returnLines      ReturnLine[]
  cancellations    Cancellation[]

  @@index([branchId, bundleGroupId])
}

// Derived per-line revenue when an order line is part of a bundle total price
// (spec section 7.1 — allocations must sum exactly to the bundle total).
model BundleAllocation {
  id                 String   @id @default(uuid())
  branchId           String @default("00000000-0000-0000-0000-000000000001")
  orderLineId        String   @unique
  derivedUnitRevenue Decimal  @db.Decimal(18, 4)
  method             String   @default("proportional_piece_count") // proportional_piece_count | explicit
  approvedOverride   Boolean  @default(false)
  createdAt          DateTime @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id])
  orderLine SalesOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([branchId])
}

// Reservations reduce StockState.availableQty (= onHand - reserved) without
// touching onHand. Posted/released inside a SERIALIZABLE transaction against
// the same StockState row used by stock.ts, so two orders can never both
// reserve the same physical pieces (acceptance test #7).
model Reservation {
  id          String    @id @default(uuid())
  branchId    String @default("00000000-0000-0000-0000-000000000001")
  orderLineId String
  costLayerId String
  gradeId     String
  binId       String
  quantity    Decimal   @db.Decimal(18, 4)
  status      String    @default("provisional") // provisional | confirmed | released
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id])
  orderLine SalesOrderLine @relation(fields: [orderLineId], references: [id])
  costLayer CostLayer      @relation(fields: [costLayerId], references: [id])
  grade     Grade          @relation(fields: [gradeId], references: [id])
  bin       Bin            @relation(fields: [binId], references: [id])

  @@index([branchId, costLayerId, status])
}

model PickAllocation {
  id           String   @id @default(uuid())
  branchId     String @default("00000000-0000-0000-0000-000000000001")
  orderLineId  String
  costLayerId  String
  gradeId      String
  binId        String
  pickedQty    Decimal  @db.Decimal(18, 4)
  pickerUserId String
  createdAt    DateTime @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  orderLine     SalesOrderLine @relation(fields: [orderLineId], references: [id])
  costLayer     CostLayer      @relation(fields: [costLayerId], references: [id])
  grade         Grade          @relation(fields: [gradeId], references: [id])
  bin           Bin            @relation(fields: [binId], references: [id])
  shipmentLines ShipmentLine[]
  returnLines   ReturnLine[]

  @@index([branchId])
}

model Shipment {
  id           String    @id @default(uuid())
  branchId     String @default("00000000-0000-0000-0000-000000000001")
  orderId      String
  courier      String?
  trackingRef  String?
  status       String    @default("unfulfilled") // mirrors SalesOrder.fulfilmentStatus granularity per shipment
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  branch Branch         @relation(fields: [branchId], references: [id])
  order  SalesOrder     @relation(fields: [orderId], references: [id])
  lines  ShipmentLine[]

  @@index([branchId])
}

model ShipmentLine {
  id               String  @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  shipmentId       String
  orderLineId      String
  pickAllocationId String?
  quantity         Decimal @db.Decimal(18, 4)

  branch         Branch          @relation(fields: [branchId], references: [id])
  shipment       Shipment        @relation(fields: [shipmentId], references: [id])
  orderLine      SalesOrderLine  @relation(fields: [orderLineId], references: [id])
  pickAllocation PickAllocation? @relation(fields: [pickAllocationId], references: [id])

  @@index([branchId])
}

model ReturnRequest {
  id                String   @id @default(uuid())
  branchId          String @default("00000000-0000-0000-0000-000000000001")
  orderId           String
  status            String   @default("requested") // requested | authorized | partially_received | received | inspected | resolved
  requestedByUserId String
  createdAt         DateTime @default(now())

  branch  Branch       @relation(fields: [branchId], references: [id])
  order   SalesOrder   @relation(fields: [orderId], references: [id])
  lines   ReturnLine[]
  refunds Refund[]

  @@index([branchId])
}

model ReturnLine {
  id                     String   @id @default(uuid())
  branchId               String @default("00000000-0000-0000-0000-000000000001")
  returnRequestId        String
  orderLineId            String
  sourcePickAllocationId String?
  costLayerId            String // the original cost layer these pieces were dispatched from — set explicitly at receipt, never re-derived
  originGradeId          String
  inspectedGradeId       String?
  quantity               Decimal  @db.Decimal(18, 4)
  disposition            String? // resaleable | repair | damaged
  originUncertain        Boolean  @default(false)
  assumptionNotes        String?
  createdAt              DateTime @default(now())

  branch               Branch          @relation(fields: [branchId], references: [id])
  returnRequest        ReturnRequest   @relation(fields: [returnRequestId], references: [id])
  orderLine            SalesOrderLine  @relation(fields: [orderLineId], references: [id])
  sourcePickAllocation PickAllocation? @relation(fields: [sourcePickAllocationId], references: [id])
  costLayer            CostLayer       @relation(fields: [costLayerId], references: [id])
  originGrade          Grade           @relation("ReturnLineOriginGrade", fields: [originGradeId], references: [id])
  inspectedGrade       Grade?          @relation("ReturnLineInspectedGrade", fields: [inspectedGradeId], references: [id])

  @@index([branchId])
}

model Refund {
  id                     String    @id @default(uuid())
  branchId               String @default("00000000-0000-0000-0000-000000000001")
  returnRequestId        String?
  orderId                String
  amount                 Decimal   @db.Decimal(18, 4)
  currencyId             String
  status                 String    @default("pending") // pending | partially_refunded | refunded
  paidAt                 DateTime?
  paymentMethodAccountId String?

  branch        Branch         @relation(fields: [branchId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  order         SalesOrder     @relation(fields: [orderId], references: [id])

  @@index([branchId])
}

// Customer receipt against one or more orders (spec section 9: Fleek/other
// channel GBP receipts, partial payments, many-to-many receipt<->order
// allocation). The exchange rate is locked onto the receipt at the moment
// it's recorded and never rewritten by a later rate refresh (acceptance
// test #13); the actual GBP->PKR conversion is a separate later event
// (CurrencyConversion below) with its own rate, distinct from this
// indicative/locked receipt rate (spec section 9).
model PaymentReceipt {
  id                     String   @id @default(uuid())
  branchId               String @default("00000000-0000-0000-0000-000000000001")
  customerId             String?
  currencyId             String
  amount                 Decimal  @db.Decimal(18, 4)
  receivedAt             DateTime
  destinationAccountId   String
  bankReference          String?
  exchangeRateSnapshotId String
  createdAt              DateTime @default(now())

  branch             Branch              @relation(fields: [branchId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  destinationAccount Account             @relation(fields: [destinationAccountId], references: [id])
  allocations        PaymentAllocation[]

  @@index([branchId])
}

model PaymentAllocation {
  id               String  @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  paymentReceiptId String
  orderId          String
  amount           Decimal @db.Decimal(18, 4)

  branch         Branch         @relation(fields: [branchId], references: [id])
  paymentReceipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id])
  order          SalesOrder     @relation(fields: [orderId], references: [id])

  @@index([branchId])
}

// GBP held in a GBP account and later converted to PKR are separate
// transactions with their own rate — never assume the receipt's locked rate
// equals the eventual conversion rate (spec section 9).
model CurrencyConversion {
  id            String   @id @default(uuid())
  branchId      String @default("00000000-0000-0000-0000-000000000001")
  fromAccountId String
  toAccountId   String
  fromAmount    Decimal  @db.Decimal(18, 4)
  toAmount      Decimal  @db.Decimal(18, 4)
  rate          Decimal  @db.Decimal(18, 6)
  bankCharges   Decimal? @db.Decimal(18, 4)
  convertedAt   DateTime @default(now())

  branch      Branch  @relation(fields: [branchId], references: [id])
  fromAccount Account @relation("ConversionFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("ConversionTo", fields: [toAccountId], references: [id])

  @@index([branchId])
}

model Cancellation {
  id               String   @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  orderLineId      String
  qty              Decimal  @db.Decimal(18, 4)
  reason           String
  feeChargedAmount Decimal? @db.Decimal(18, 4)
  feeBeneficiary   String?
  refundDueAmount  Decimal? @db.Decimal(18, 4)
  approvedByUserId String?
  createdAt        DateTime @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id])
  orderLine SalesOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([branchId])
}

// ---------- Finance ----------

model Account {
  id         String  @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  code       String? // stable key for seeded control accounts (e.g. "ACCOUNTS_RECEIVABLE"); null for ordinary bank/cash accounts
  label      String
  currencyId String
  kind       String // cash | bank | platform_escrow | control
  // Determines the report-sign convention for getAccountBalance(): a debit
  // increases an asset/expense account's balance; a credit increases a
  // liability/equity/revenue/contra_revenue account's balance.
  nature     String  @default("asset") // asset | liability | equity | revenue | contra_revenue | expense
  isActive   Boolean @default(true)

  branch            Branch               @relation(fields: [branchId], references: [id])
  ledgerEntries     LedgerEntry[]
  expenses          Expense[]
  transfersFrom     Transfer[]           @relation("TransferFrom")
  transfersTo       Transfer[]           @relation("TransferTo")
  ownerTransactions OwnerTransaction[]
  paymentReceipts   PaymentReceipt[]
  conversionsFrom   CurrencyConversion[] @relation("ConversionFrom")
  conversionsTo     CurrencyConversion[] @relation("ConversionTo")

  @@unique([branchId, code])
  @@index([branchId])
}

// Double-entry ledger. Balances are always derived by summing entries for an
// account, never stored as an editable field (spec section 11).
model LedgerEntry {
  id                  String   @id @default(uuid())
  branchId            String @default("00000000-0000-0000-0000-000000000001")
  accountId           String
  direction           String // debit | credit
  amount              Decimal  @db.Decimal(18, 4)
  currencyId          String
  relatedDocumentType String
  relatedDocumentId   String
  postedAt            DateTime @default(now())
  reversalOfId        String?

  branch  Branch  @relation(fields: [branchId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([branchId, accountId, postedAt])
}

model Expense {
  id                  String   @id @default(uuid())
  branchId            String @default("00000000-0000-0000-0000-000000000001")
  date                DateTime
  payeeType           String // supplier | other
  payeeId             String?
  categoryId          String // ExpenseCategory.id, plain reference
  currencyId          String
  amount              Decimal  @db.Decimal(18, 4)
  paymentStatus       String   @default("unpaid")
  accountId           String
  receiptMediaAssetId String?
  relatedOrderId      String?
  relatedLotId        String?
  approvedByUserId    String?
  createdAt           DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([branchId])
}

// Explicitly excluded from revenue/expense reports (spec section 11).
model Transfer {
  id            String   @id @default(uuid())
  branchId      String @default("00000000-0000-0000-0000-000000000001")
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(18, 4)
  currencyId    String
  occurredAt    DateTime @default(now())

  branch      Branch  @relation(fields: [branchId], references: [id])
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])

  @@index([branchId])
}

// Owner contributions/withdrawals — excluded from trading P&L (spec section 11).
model OwnerTransaction {
  id         String   @id @default(uuid())
  branchId   String @default("00000000-0000-0000-0000-000000000001")
  accountId  String
  amount     Decimal  @db.Decimal(18, 4)
  type       String // contribution | withdrawal
  occurredAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([branchId])
}

model PeriodLock {
  id               String    @id @default(uuid())
  branchId         String @default("00000000-0000-0000-0000-000000000001")
  periodStart      DateTime
  periodEnd        DateTime
  lockedByUserId   String
  lockedAt         DateTime  @default(now())
  reopenedByUserId String?
  reopenedAt       DateTime?
  reopenReason     String?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// Caches a mutating request's response by client-supplied Idempotency-Key so
// a retried request (e.g. after a timeout where the client never saw the
// first response) replays the same result instead of creating a second
// order/payment/GRN/movement set (spec: never treat a repeated network
// request as authorization to post a transaction twice; acceptance test #15).
// GLOBAL — pure request-dedup infrastructure, not business data.
model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  method       String
  path         String
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())

  @@unique([key, method, path])
}
